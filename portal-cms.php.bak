<?php require_once 'includes/footer.php'; ?>
<script>
if(typeof lucide!=='undefined') lucide.createIcons();
function syncBody(){document.getElementById('bodyInput').value=document.getElementById('bodyEd').innerHTML;}
function wrapTag(t){const ed=document.getElementById('bodyEd');ed.focus();const sel=window.getSelection();if(sel.rangeCount>0){const r=sel.getRangeAt(0),el=document.createElement(t);el.textContent=sel.toString()||'Text here';r.deleteContents();r.insertNode(el);}}
document.querySelectorAll('.fup').forEach(i=>{i.addEventListener('change',()=>{const z=i.previousElementSibling;if(z&&z.classList.contains('uz')){const p=z.querySelector('p');if(p&&i.files[0])p.textContent='✓ '+i.files[0].name;z.style.borderColor='#123D2B';z.style.background='#f0fdf4';}});});
</script>
</body>
</html>
