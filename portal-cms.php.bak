            <td style="position:relative;">
                <details>
                    <summary class="btn btn-ol btn-sm">Respond</summary>
                    <div class="drp">
                        <div style="font-size:.76rem;font-weight:700;color:var(--muted);margin-bottom:7px;">From: <?= htmlspecialchars($inq['full_name']) ?> — <?= htmlspecialchars($inq['email']) ?></div>
                        <div class="inq-msg"><?= htmlspecialchars($inq['message']) ?></div>
                        <form method="POST" style="margin-top:14px;">
